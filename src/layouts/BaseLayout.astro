---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SplashScreen from '../components/SplashScreen.astro';
import { dict, LANG_STORAGE_KEY, pathFor, type Lang } from '../i18n/index.ts';

interface Props {
  lang: Lang;
  /** Ruta de esta página en inglés (`/`, `/fuentes/`, `/offline/`): de ahí salen el selector y los enlaces entre idiomas. */
  path: string;
  title: string;
  description?: string;
}
const { lang, path, title, description } = Astro.props;
const t = dict(lang);
// Quien eligió español antes y entra por la ruta en inglés pasa a la española; nunca al revés.
const redirect = `try{if(localStorage.getItem(${JSON.stringify(LANG_STORAGE_KEY)})==='es'&&location.pathname.indexOf('/es')!==0)location.replace('/es'+location.pathname+location.search+location.hash)}catch(e){}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t.SITIO.descripcion} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={pathFor('en', path)} />
    <link rel="alternate" hreflang="es" href={pathFor('es', path)} />
    {lang === 'en' && <script is:inline set:html={redirect}></script>}
  </head>
  <body>
    <SplashScreen />
    <a class="saltar" href="#contenido">{t.SITIO.saltar}</a>
    <Header lang={lang} path={path} />
    <main id="contenido" tabindex="-1" class="mx-auto max-w-3xl px-4 py-6">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
  </body>
</html>

---
// Pantalla de carga orbital: 1,1 s en la primera entrada de la sesión. Decorativa (aria-hidden), sin bloquear clics.
// Sin JS, con movimiento reducido o ya vista en la sesión: no se muestra. El tiempo lo manda el CSS (animación con retraso).
const KEY = 'agroshift:splash';
const boot = `try{var d=document.documentElement,s=document.querySelector('.splash');if(s&&!matchMedia('(prefers-reduced-motion: reduce)').matches&&!sessionStorage.getItem(${JSON.stringify(KEY)})){sessionStorage.setItem(${JSON.stringify(KEY)},'1');d.setAttribute('data-splash','');var c=function(){s.setAttribute('data-cerrado','')};document.addEventListener('pointerdown',c,{once:true});s.addEventListener('animationend',function(){s.hidden=true;document.removeEventListener('pointerdown',c)})}}catch(e){}`;
---
<div class="splash" aria-hidden="true">
  <svg class="splash__escena" viewBox="0 0 420 300" focusable="false">
    <g class="splash__anillos" fill="none" stroke="#c5f87a">
      <circle cx="210" cy="150" r="140" stroke-opacity="0.07" stroke-dasharray="2 5" />
      <circle cx="210" cy="150" r="104" stroke-opacity="0.09" />
    </g>
    <g transform="rotate(-20 210 150)">
      <ellipse cx="210" cy="150" rx="168" ry="56" fill="none" stroke="#c5f87a" stroke-opacity="0.4" stroke-width="1" />
      <g transform="translate(210 150)">
        <circle class="splash__satelite-halo" r="8" fill="#c5f87a" opacity="0.25" />
        <circle class="splash__satelite" r="4" fill="#c5f87a" />
      </g>
    </g>
    <g class="splash__centro">
      <svg x="177" y="88" width="66" height="66" viewBox="0 0 40 40">
        <rect width="40" height="40" rx="10" fill="#c5f87a" />
        <path d="M20 31V20" stroke="#0f291e" stroke-width="2.2" stroke-linecap="round" fill="none" />
        <path d="M20 23C14.5 23 11.5 19.5 11.5 14.5C16.5 14.5 20 17.5 20 23Z" fill="#0f291e" />
        <path d="M20 20C20 14.5 23.5 11 29 11C29 16.5 25.5 20 20 20Z" fill="#0f291e" />
        <ellipse cx="20" cy="20" rx="15.5" ry="6.5" transform="rotate(-28 20 20)" stroke="#0f291e" stroke-width="1.4" fill="none" />
      </svg>
      <text x="210" y="194" text-anchor="middle" font-size="34" letter-spacing="-0.5" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"><tspan fill="#eef3e8" font-weight="300">Agro</tspan><tspan fill="#c5f87a" font-weight="700">Shift</tspan></text>
      <text x="210" y="216" text-anchor="middle" font-size="10" letter-spacing="4" fill="#c3d3bd" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif">ONECTRL</text>
    </g>
  </svg>
</div>
<script is:inline set:html={boot}></script>
<style is:global>
  .splash {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    place-items: center;
    background: radial-gradient(ellipse at center, #123323 0%, #081710 100%);
    pointer-events: none; /* nunca estorba: ni a clics ni a pruebas automáticas */
  }
  .splash::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image: radial-gradient(#c5f87a 1px, transparent 1.5px);
    background-size: 28px 28px;
  }
  [data-splash] .splash { display: grid; animation: splash-fuera 0.35s ease 1.1s both; }
  [data-splash] .splash[data-cerrado] { animation-duration: 0.15s; animation-delay: 0s; }
  .splash__escena { position: relative; width: min(30rem, 92vw); height: auto; overflow: visible; }
  .splash__centro { animation: splash-entra 0.5s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .splash__satelite, .splash__satelite-halo {
    offset-path: path("M168 0 A168 56 0 1 1 -168 0 A168 56 0 1 1 168 0");
    offset-rotate: 0deg;
    animation: splash-orbita 3.2s linear infinite;
  }
  .splash__satelite-halo { animation-name: splash-orbita, splash-pulso; animation-duration: 3.2s, 1.6s; animation-timing-function: linear, ease-in-out; animation-iteration-count: infinite; }
  @keyframes splash-orbita { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  @keyframes splash-pulso { 50% { opacity: 0.08; } }
  @keyframes splash-entra { from { opacity: 0; transform: translateY(6px); } }
  @keyframes splash-fuera { to { opacity: 0; transform: scale(1.02); visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .splash { display: none !important; } }
</style>

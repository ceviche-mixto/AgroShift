---
import { PIE } from '../content/es.ts';
---
<footer class="pie">
  <div class="pie__contenido">
    <div class="pie__marca">
      <p class="pie__nombre">{PIE.nombre}</p>
      <p class="pie__aviso">{PIE.aviso}</p>
      <p><a class="enlace" href="/fuentes/">{PIE.fuentes}</a></p>
    </div>
    <div class="pie__evento">
      <p class="pie__evento-titulo">{PIE.evento}</p>
      <p class="pie__equipo" data-ff="team">{PIE.equipo}</p>
    </div>
  </div>
</footer>

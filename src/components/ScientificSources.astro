---
// Texto técnico solo dentro del detalle. La isla clona `source` por cada dataset realmente usado.
import { dict, type Lang } from '../i18n/index.ts';

const { lang } = Astro.props as { lang: Lang };
const { PANEL_FUENTES: P } = dict(lang);
---
<details data-ff="sources" class="fuentes">
  <summary class="fuentes__resumen">{P.resumen}</summary>
  <div class="fuentes__cuerpo">
    <ul data-ff="sources-list" class="fuentes__lista"></ul>
  </div>

  <template data-ff-tpl="source">
    <li class="fuente">
      <h4 class="subtitulo"><span data-slot="name"></span></h4>
      <p><a data-slot="link" href="#" target="_blank" rel="noopener noreferrer" class="enlace"></a></p>
      <div data-slot="state"></div>
      <dl class="fuente__datos">
        <div><dt>{P.queMide}</dt><dd data-slot="variable" class="dato-tecnico"></dd></div>
        <div><dt>{P.unidad}</dt><dd data-slot="unit"></dd></div>
        <div><dt>{P.periodo}</dt><dd data-slot="period"></dd></div>
        <div><dt>{P.fechaDato}</dt><dd data-slot="retrieved"></dd></div>
        <div><dt>{P.escala}</dt><dd data-slot="scale"></dd></div>
        <div><dt>{P.vigencia}</dt><dd data-slot="validity"></dd></div>
        <div><dt>{P.origen}</dt><dd data-slot="origin"></dd></div>
        <div><dt>{P.limitaciones}</dt><dd><ul data-slot="limitations" class="lista"></ul></dd></div>
      </dl>
    </li>
  </template>
</details>

---
// Texto técnico solo dentro del detalle. La isla clona `source` por cada dataset realmente usado.
---
<details data-ff="sources" class="fuentes">
  <summary class="fuentes__resumen">Fuentes Científicas Utilizadas</summary>
  <div class="fuentes__cuerpo">
    <ul data-ff="sources-list" class="fuentes__lista"></ul>
  </div>

  <template data-ff-tpl="source">
    <li class="fuente">
      <h4 class="subtitulo"><span data-slot="name"></span></h4>
      <p><a data-slot="link" href="#" target="_blank" rel="noopener noreferrer" class="enlace"></a></p>
      <div data-slot="state"></div>
      <dl class="fuente__datos">
        <div><dt>Qué mide</dt><dd data-slot="variable" class="dato-tecnico"></dd></div>
        <div><dt>Unidad</dt><dd data-slot="unit"></dd></div>
        <div><dt>Periodo</dt><dd data-slot="period"></dd></div>
        <div><dt>Fecha del dato</dt><dd data-slot="retrieved"></dd></div>
        <div><dt>Escala</dt><dd data-slot="scale"></dd></div>
        <div><dt>Vigencia</dt><dd data-slot="validity"></dd></div>
        <div><dt>Origen</dt><dd data-slot="origin"></dd></div>
        <div><dt>Limitaciones</dt><dd><ul data-slot="limitations" class="lista"></ul></dd></div>
      </dl>
    </li>
  </template>
</details>

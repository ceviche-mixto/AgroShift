---
// Isotipo (baldosa lima, brote oscuro, órbita fina) + palabra «AgroShift». Solo vectores, decorativo: el nombre accesible es el texto.
interface Props {
  /** Tamaño del isotipo en px. */
  size?: number;
}
const { size = 36 } = Astro.props;
---
<span class="marca">
  <svg class="marca__isotipo" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="10" fill="#C5F87A" />
    <path d="M20 31V20" stroke="#0F291E" stroke-width="2.2" stroke-linecap="round" fill="none" />
    <path d="M20 23C14.5 23 11.5 19.5 11.5 14.5C16.5 14.5 20 17.5 20 23Z" fill="#0F291E" />
    <path d="M20 20C20 14.5 23.5 11 29 11C29 16.5 25.5 20 20 20Z" fill="#0F291E" />
    <ellipse cx="20" cy="20" rx="15.5" ry="6.5" transform="rotate(-28 20 20)" stroke="#0F291E" stroke-width="1.4" fill="none" />
  </svg>
  <span class="marca__nombre"><span class="marca__agro">Agro</span><span class="marca__shift">Shift</span></span>
</span>

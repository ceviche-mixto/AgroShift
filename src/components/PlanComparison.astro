---
// Plan A y Plan B juntos. La isla clona la plantilla `plan` en cada montaje y rellena los slots.
import { dict, type Lang } from '../i18n/index.ts';

const { lang } = Astro.props as { lang: Lang };
const { SECCIONES_PLAN: S } = dict(lang);
---
<div class="pila">
  <div data-ff="result-state"></div>

  <div class="planes">
    <div data-ff="plan-a"></div>
    <div data-ff="plan-b"></div>
  </div>

  <section data-ff="missing" class="pila-corta" aria-labelledby="falta-titulo" hidden>
    <h3 id="falta-titulo" class="subtitulo">{S.queFalta}</h3>
    <ul data-slot="list" class="lista"></ul>
  </section>

  <template data-ff-tpl="plan">
    <article class="plan">
      <h3 class="plan__encabezado">
        <span data-slot="role" class="plan__rol"></span>
        <span data-slot="title" class="plan__titulo"></span>
      </h3>
      <p data-slot="condition" class="plan__condicion"></p>
      <p data-slot="intro" class="plan__intro"></p>

      <div data-group="signals" class="plan__grupo">
        <h4 class="subtitulo">{S.cuandoCambiar}</h4>
        <ul data-slot="list" class="lista"></ul>
      </div>
      <div data-group="reasons" class="plan__grupo">
        <h4 class="subtitulo">{S.porQue}</h4>
        <ul data-slot="list" class="lista"></ul>
      </div>
      <div data-group="restrictions" class="plan__grupo">
        <h4 class="subtitulo">{S.tenEnCuenta}</h4>
        <ul data-slot="list" class="lista"></ul>
      </div>
      <div data-group="actions" class="plan__grupo">
        <h4 class="subtitulo">{S.queHacer}</h4>
        <ul data-slot="list" class="lista"></ul>
      </div>
      <div data-group="toverify" class="plan__grupo">
        <h4 class="subtitulo">{S.queRevisar}</h4>
        <ul data-slot="list" class="lista"></ul>
      </div>
    </article>
  </template>
</div>

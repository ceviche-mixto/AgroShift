---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dict, pathFor, type Lang } from '../i18n/index.ts';

const { lang } = Astro.props as { lang: Lang };
const t = dict(lang).SITIO.sinConexion;
---
<BaseLayout lang={lang} path="/offline/" title={t.titulo} description={t.descripcion}>
  <h1 class="text-3xl font-bold leading-tight">{t.encabezado}</h1>
  <div class="estado estado--sindato mt-6">
    <p class="estado__etiqueta"><span class="estado__simbolo" aria-hidden="true">?</span> {t.etiqueta}</p>
    <p class="estado__titulo">{t.estadoTitulo}</p>
    <p>{t.explicacion}</p>
    <p class="estado__paso">{t.siguientePaso}</p>
  </div>
  <p class="mt-6"><a class="boton" href={pathFor(lang, '/')}>{t.volver}</a></p>
</BaseLayout>

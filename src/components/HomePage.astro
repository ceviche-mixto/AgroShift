---
import BaseLayout from '../layouts/BaseLayout.astro';
import FarmForm from './FarmForm.astro';
import PlanComparison from './PlanComparison.astro';
import Alerts from './Alerts.astro';
import ContextQuestions from './ContextQuestions.astro';
import ScientificSources from './ScientificSources.astro';
import { dict, type Lang } from '../i18n/index.ts';

// Pantalla principal. La ruta `/` la muestra en inglés y `/es/` en español.
const { lang } = Astro.props as { lang: Lang };
const { ESTADOS, AVISO_DECISION, SITIO } = dict(lang);
const t = SITIO.inicio;
---
<BaseLayout lang={lang} path="/" title="AgroShift" description={SITIO.descripcion}>
  <div data-farm-flow class="pila-grande">
    <div class="pila-corta">
      <h1 class="text-3xl font-bold leading-tight">{t.titulo}</h1>
      <p class="texto-suave">{t.intro}</p>
    </div>

    <FarmForm lang={lang} />

    <div data-ff="status" role="status" aria-live="polite"></div>

    <div data-ff="loading" class="espera" hidden>
      <span class="espera__giro" aria-hidden="true"></span>
      <p>
        <strong>{ESTADOS.espera.titulo}</strong><br />
        {ESTADOS.espera.explicacion}
      </p>
    </div>

    <div data-ff="net" hidden></div>

    <section data-ff="results" class="pila-grande" aria-labelledby="results-title" hidden>
      <h2 id="results-title" data-ff="results-title" tabindex="-1" class="text-2xl font-bold leading-tight">
        {t.resultados}
      </h2>
      <PlanComparison lang={lang} />
      <Alerts lang={lang} />
      <div class="acciones">
        <button type="button" class="opcion" data-ff="edit">{t.editar}</button>
        <button type="button" class="opcion" data-ff="save">{t.guardar}</button>
        <button type="button" class="opcion" data-ff="refresh" hidden>{t.actualizar}</button>
      </div>
      <ContextQuestions lang={lang} />
      <ScientificSources lang={lang} />
      <p class="texto-suave">{AVISO_DECISION}</p>
    </section>

    <section data-ff="saved" class="pila" aria-labelledby="saved-title" hidden>
      <h2 id="saved-title" class="text-2xl font-bold leading-tight">{t.guardados}</h2>
      <ul data-ff="saved-list" class="guardados"></ul>
    </section>

    <template data-ff-tpl="message">
      <div class="estado">
        <p class="estado__etiqueta">
          <span class="estado__simbolo" data-slot="symbol" aria-hidden="true"></span>
          <span data-slot="label"></span>
        </p>
        <p class="estado__titulo" data-slot="title"></p>
        <p data-slot="text"></p>
        <p class="estado__paso" data-slot="step"></p>
      </div>
    </template>

    <template data-ff-tpl="saved-item">
      <li class="guardado">
        <p class="guardado__texto">
          <span data-slot="title" class="guardado__titulo"></span>
          <span data-slot="date" class="texto-suave"></span>
        </p>
        <button type="button" class="opcion" data-act="open">{t.ver}</button>
        <button type="button" class="opcion" data-act="delete">{t.quitar}</button>
      </li>
    </template>
  </div>
  <script>
    import '../islands/FarmFlow.ts';
  </script>
</BaseLayout>

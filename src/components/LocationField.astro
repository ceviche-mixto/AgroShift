---
import { dict, type Lang } from '../i18n/index.ts';

const { lang } = Astro.props as { lang: Lang };
const { CAMPOS, COORDENADAS_MANUAL, FORMULARIO_EXTRA, MAPA_PARCELA: M } = dict(lang);
const c = CAMPOS.ubicacion;
---
<div class="pila">
  <input type="hidden" name="origin" value="manual_coordinates" />
  <input type="hidden" name="accuracy" value="" />

  <div>
    <button type="button" class="opcion" data-ff="gps">{c.opciones.gps}</button>
  </div>

  <div class="pila-corta">
    <label for="place" class="etiqueta">{c.localidad}</label>
    <div class="fila-busqueda">
      <input
        type="text"
        id="place"
        name="place"
        class="entrada"
        autocomplete="off"
        autocapitalize="words"
        enterkeyhint="search"
        aria-describedby="error-ubicacion"
      />
      <button type="button" class="opcion" data-ff="search">{c.opciones.place_search}</button>
    </div>
  </div>

  <div data-ff="location-status" aria-live="polite" class="texto-suave"></div>

  <fieldset data-ff="place-results" class="opciones" hidden>
    <legend class="etiqueta">{FORMULARIO_EXTRA.eligeLocalidad}</legend>
  </fieldset>

  <div>
    <button type="button" class="opcion" data-ff="map-toggle" aria-expanded="false" aria-controls="mapa-parcela">{M.abrir}</button>
  </div>

  <div id="mapa-parcela" data-ff="map" role="group" aria-label={M.region} class="mapa-parcela" hidden>
    <p class="texto-suave">{M.ayuda}</p>
    <div data-ff="map-canvas" class="mapa-parcela__lienzo" tabindex="0"></div>
    <p data-ff="map-status" aria-live="polite" class="mapa-parcela__estado"></p>
    <div class="mapa-parcela__acciones">
      <button type="button" class="opcion" data-ff="map-center">{M.marcarCentro}</button>
      <button type="button" class="opcion" data-ff="map-clear">{M.limpiar}</button>
      <button type="button" class="opcion" data-ff="map-use" disabled>{M.usar}</button>
    </div>
  </div>

  <div>
    <button type="button" class="enlace enlace--boton" data-ff="coords-toggle" aria-expanded="false" aria-controls="coordenadas">
      {COORDENADAS_MANUAL}
    </button>
  </div>

  <div id="coordenadas" data-ff="coords" role="group" aria-label={COORDENADAS_MANUAL} class="pila-corta" hidden>
    <div class="par">
      <div class="pila-corta">
        <label for="lat" class="etiqueta etiqueta--fina">{c.latitud}</label>
        <input
          type="text"
          id="lat"
          name="lat"
          class="entrada dato-tecnico"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          placeholder={lang === 'en' ? '-6.77' : '-6,77'}
          aria-describedby="error-ubicacion"
        />
      </div>
      <div class="pila-corta">
        <label for="lon" class="etiqueta etiqueta--fina">{c.longitud}</label>
        <input
          type="text"
          id="lon"
          name="lon"
          class="entrada dato-tecnico"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          placeholder={lang === 'en' ? '-79.84' : '-79,84'}
          aria-describedby="error-ubicacion"
        />
      </div>
    </div>
  </div>

  <template data-ff-tpl="place-option">
    <label class="opcion-fila">
      <input type="radio" name="place_choice" />
      <span>
        <span data-slot="name" class="opcion-fila__nombre"></span>
        <span data-slot="coords" class="dato-tecnico texto-suave"></span>
      </span>
    </label>
  </template>
</div>

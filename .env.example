# Valores ficticios. Copia a .env y reemplaza. Nunca subas .env.
# Públicos (expuestos al navegador)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Servidor (Supabase). Obtén el valor del proyecto elegido por un canal seguro:
# panel de Supabase > Project Settings > API keys > Secret keys. Nunca lo pegues en chats, logs ni commits.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Servidor (NASA)
NASA_API_KEY=your-nasa-api-key
EARTHDATA_TOKEN=your-earthdata-token
FIRMS_MAP_KEY=your-firms-map-key

# Solo ingesta (scripts/ingest-smap.ts y scripts/ingest-giovanni.ts). No se configuran en el runtime web.
# AppEEARS y Giovanni exigen usuario y contraseña de Earthdata Login: no aceptan EARTHDATA_TOKEN.
EARTHDATA_USERNAME=your-earthdata-username
EARTHDATA_PASSWORD=your-earthdata-password

# Servidor (explicaciones). EXPLAIN_CONTEXT_SECRET firma el contexto entre /api/analyze y /api/explain:
# genera uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPLAIN_CONTEXT_SECRET=your-random-64-hex-secret
# Amazon Bedrock Converse con clave de API de Bedrock y permiso mínimo de invocación del modelo.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
